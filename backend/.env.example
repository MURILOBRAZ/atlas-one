# Connection string do banco PostgreSQL hospedado no Neon.
# Copie este arquivo para .env e substitua pelos dados do seu projeto Neon.
# NUNCA versione o arquivo .env.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Porta HTTP da Atlas API.
PORT=3333

# Enquanto não existe autenticação, a API considera este funcionário
# como o usuário "logado" no aplicativo.
CURRENT_EMPLOYEE_REGISTRATION=ATL-2847
