{
  "name": "atlas-api",
  "version": "1.0.0",
  "description": "Atlas API - backend REST do aplicativo Atlas One (Atlas Logistics)",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/run-sql.ts ../database/schema.sql",
    "db:seed": "tsx scripts/run-sql.ts ../database/seed.sql"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@neondatabase/serverless": "^1.1.0",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
